"screenspace_general"
{
    // v3 (16 Nov 2026): the depth sampler (_rt_ResolvedFullFrameDepth, float) must NOT be sRGB-decoded,
    // and the AO target (AO + packed 16-bit depth) is written as raw bytes; bs2_ssao_blur reads it raw too.
    "$pixshader" "bs2_ssao_ps20b"
    "$basetexture" "_rt_FullFrameFB"
    "$texture1" "_rt_ResolvedFullFrameDepth"
    "$ignorez" "1"
    "$linearread_basetexture" "0"
    "$linearread_texture1" "1"
    "$linearwrite" "1"
    "$c0_x" "0.0005" "$c0_y" "0.0009" "$c0_z" "1.2" "$c0_w" "24"
    "$c1_x" "30000" "$c1_y" "1" "$c1_z" "0.56" "$c1_w" "12"
    "$c2_x" "3000" "$c2_y" "0" "$c2_z" "0" "$c2_w" "0"
    "$c3_x" "0" "$c3_y" "0" "$c3_z" "0" "$c3_w" "0"
}
