	input Show(void) : "Show the card (queued if another card is showing)."
	input Hide(void) : "Fade this card out (also removes it from the queue)."
	input Skip(void) : "Fade this card out fast; the next card in the queue starts."

	output OnShown(void) : "Fired when the Show input has sent the card to the screen."
]
