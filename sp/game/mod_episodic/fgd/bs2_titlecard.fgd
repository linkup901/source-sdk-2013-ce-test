// Black Stasis 2, Phase 2 - A1. point_bs2_titlecard (sp/src/game/server/bs2/point_bs2_titlecard.cpp, HUD: client/bs2/bs2_hud_titlecard.cpp)
@PointClass base(Targetname) iconsprite("editor/env_message.vmt") = point_bs2_titlecard : "Black Stasis 2 title card. Up to 8 text blocks that fade in one after another, hold, and fade out; a card that is shown while another one is on screen waits its turn. With Style = Hint it is the small bottom-right hint ('Press %use% to skip') instead."
[
	holdtime(float) : "Hold time" : 4 : "Seconds the card stays after its last block has finished fading in."
	fadeouttime(float) : "Fade out time" : 1.5
	style(choices) : "Style" : 0 =
	[
		0 : "Title card"
		1 : "Hint (bottom right, uses block 1 only, text up to 30 px)"
	]
	blackbackground(choices) : "Black background" : 0 : "A full-screen black behind the card (when the map has not blacked the screen out itself)." =
	[
		0 : "No"
		1 : "Yes"
	]
	bgfade(float) : "Background fade in" : 0 : "Seconds the black takes to fade in."
	forever(choices) : "Stay until Hide / Skip" : 0 =
	[
		0 : "No (hold time, then fade out)"
		1 : "Yes"
	]

	// ---- block 1
	text1(string) : "Block 1: text" : "" : "Up to 150 characters. '|' is a line break, %use% is the key bound to +use. Empty = the block is not shown."
	font1(choices) : "Block 1: font" : 0 : "Title = D-DIN Bold, else Anton, else Bebas Neue, else the scheme title font. Small and the hint = D-DIN regular, else Trebuchet MS." =
	[
		0 : "Title"
		1 : "Serif (dictionary card)"
		2 : "Small (D-DIN regular)"
	]
	size1(integer) : "Block 1: size" : 72 : "Text height in pixels at 1080 lines (scaled to the screen)."
	x1(float) : "Block 1: x" : 0.5 : "Anchor, fraction of the screen width (0.17 = the left third's middle)."
	y1(float) : "Block 1: y" : 0.5 : "Anchor, fraction of the screen height. The block is centred on it vertically."
	align1(choices) : "Block 1: align" : 1 : "Which part of the text sits on x." =
	[
		0 : "Left"
		1 : "Centre"
		2 : "Right"
	]
	delay1(float) : "Block 1: delay" : 0 : "Seconds after the card starts until this block begins to fade in."
	fadein1(float) : "Block 1: fade in" : 1 : "Seconds the block takes to fade in."
	color1(color255) : "Block 1: colour" : "255 255 255"
	alpha1(integer) : "Block 1: alpha" : 255

	// ---- block 2
	text2(string) : "Block 2: text" : "" : "Up to 150 characters. '|' is a line break, %use% is the key bound to +use. Empty = the block is not shown."
