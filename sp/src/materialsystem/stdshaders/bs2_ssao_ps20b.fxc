// v3 (16 Nov 2026): s1 is sampled WITHOUT sRGB decode ($linearread_texture1 1) and the output is written raw ($linearwrite 1).
// BS2 SSAO pass 1 (SEPPMA Phase 3). screenspace_general: s0 scene (unused in mode 1), s1 linear depth/far (_rt_ResolvedFullFrameDepth).
// Crease AO without normals: for opposite taps s1,s2 the plane through them predicts 1/z = (1/s1+1/s2)/2,
// so concavity = z - harmonic_mean(s1,s2) is exactly 0 on any plane, >0 in creases/contact.
sampler2D Scene : register(s0);
sampler2D Depth : register(s1);
float4 P0 : register(c0); // invW, invH (depth texture), strength, radius (units)
float4 P1 : register(c1); // far plane, tan(halfFovX), tan(halfFovY), falloff (units)
float4 P2 : register(c2); // max distance, debug (mode 0), mode (1 = write AO+depth), output scale
float4 P3 : register(c3); // fog start, 1/(fog end - fog start) (0 = no fog), fog max density, screen->depth-texture uv scale (v3)

float LinZ(float2 uv) { return tex2D(Depth, uv).r * P1.x; }

float Pair(float2 uv, float2 o, float z)
{
    float s1 = max(LinZ(uv + o), 1.0);
    float s2 = max(LinZ(uv - o), 1.0);
    float h = 2.0 / (1.0 / max(s1, 1.0) + 1.0 / max(s2, 1.0));
    float conc = z - h;
    // Polish (16 Nov): range check was a hard 3 x radius step, which let a near object (NPC, prop in front of the camera)
    // cast a blocky hard-edged halo onto the floor behind it. Now full weight up to 2 x radius, fading to 0 at 3 x radius
    // (1 x .. 2 x was tried: removes the halo but also most room-corner AO at grazing angles).
    float valid = saturate(3.0 - max(abs(z - s1), abs(z - s2)) / max(P0.w, 1.0));
    return saturate((conc - 0.01 * z) / max(P1.w, 1.0)) * valid;   // 1% bias: flat planes (depth not exactly view-z) read 0
}

float4 main(float2 uv : TEXCOORD0) : COLOR0
{
    // depth target = view depth / view zFar (P1.x), cleared to 1.0 where nothing was drawn (sky)
    float dr = tex2D(Depth, uv).r;
    float notSky = step(0.0002, abs(dr - 1.0));   // exactly 1.0 = cleared (nothing drawn); real depth can exceed 1
    float z = max(dr * P1.x, 1.0);
    float d = saturate(z / 8192.0);     // packed for the blur pass
    float2 r = P0.w / (2.0 * z * P1.yz);
    r *= P3.w;   // v3: screen -> depth-texture uv (0.5 with the half-res depth pre-pass)
    r = min(r, float2(0.08, 0.08) * P3.w);
    // 4x4 interleaved rotation (Bayer order) in output pixels; the 4x4 blur pass averages it out exactly
    float2 cell = fmod(floor(uv / (P0.xy * max(P2.w, 1.0))), 4.0);
    float idx = cell.y * 4.0 + cell.x;                 // 16 distinct rotations per 4x4 cell
    float a = 6.2831853 * (frac(idx * 0.3125) + 0.03125); // 0.3125 = 5/16: scatters neighbouring cells' angles
    float s, c; sincos(a, s, c);
    float2x2 rot = float2x2(c, -s, s, c);
    float occ = 0;
    occ += Pair(uv, mul(rot, float2( 1.000,  0.000)) * r * 0.30, z);
    occ += Pair(uv, mul(rot, float2( 0.500,  0.866)) * r * 0.45, z);
    occ += Pair(uv, mul(rot, float2(-0.500,  0.866)) * r * 0.60, z);
    occ += Pair(uv, mul(rot, float2( 0.866,  0.500)) * r * 0.75, z);
    occ += Pair(uv, mul(rot, float2( 0.000,  1.000)) * r * 0.90, z);
    occ += Pair(uv, mul(rot, float2(-0.866,  0.500)) * r * 1.00, z);
    occ /= 6.0;
    float fade = saturate(1.0 - z / P2.x) * notSky;
    fade *= 1.0 - P3.z * saturate((z - P3.x) * P3.y);   // fogged pixels already show fog colour: no crease shadow on them
    float ao = saturate(1.0 - P0.z * saturate(occ) * fade);
    float hi = floor(d * 255.0) / 255.0;
    float4 packed = float4(ao, hi, frac(d * 255.0), 1);
    // diagnostic (P2.y > 0.5 in mode 1): R = occlusion x4, G = fade, B = tap radius (uv x 10)
    packed = lerp(packed, float4(saturate(occ * 4.0), fade, saturate(r.x * 10.0), 1), step(0.5, P2.y) * step(P2.y, 1.5));
    // diagnostic 2 (P2.y > 1.5): R = ao, G = occ, B = fade
    packed = lerp(packed, float4(ao, saturate(occ), fade, 1), step(1.5, P2.y) * step(P2.y, 2.5));
    // diagnostic 3 (P2.y > 2.5, v3 depth proof): R = z/4096, G = z/512, B = 32/z (z = view depth in units as this pass sees it)
    packed = lerp(packed, float4(saturate(z / 4096.0), saturate(z / 512.0), saturate(32.0 / z), 1), step(2.5, P2.y));
    float3 scene = tex2D(Scene, uv).rgb;
    float4 comp = float4(lerp(scene * ao, ao.xxx, P2.y), 1);
    return lerp(comp, packed, step(0.5, P2.z));
}
