// BS2_Puddle vertex shader (SM3): same as BS2_Glass (world pos/normal, uv, light atten, screen pos).
// DYNAMIC: "COMPRESSED_VERTS" "0..1"
// DYNAMIC: "SKINNING" "0..1"
#include "common_vs_fxc.h"
static const bool g_bSkinning = SKINNING ? true : false;
struct VS_INPUT
{
	float4 vPos         : POSITION;
	float4 vBoneWeights : BLENDWEIGHT;
	float4 vBoneIndices : BLENDINDICES;
	float4 vNormal      : NORMAL;
	float2 vTexCoord0   : TEXCOORD0;
};
struct VS_OUTPUT
{
	float4 projPos     : POSITION;
	float2 uv          : TEXCOORD0;
	float3 worldPos    : TEXCOORD1;
	float3 worldNormal : TEXCOORD2;
	float4 atten       : TEXCOORD3;
	float4 screen      : TEXCOORD4;
};
VS_OUTPUT main( const VS_INPUT v )
{
	VS_OUTPUT o = ( VS_OUTPUT )0;
	float3 vNormal;
	DecompressVertex_Normal( v.vNormal, vNormal );
	float3 worldPos, worldNormal;
	SkinPositionAndNormal( g_bSkinning, v.vPos, vNormal, v.vBoneWeights, v.vBoneIndices, worldPos, worldNormal );
	o.projPos = mul( float4( worldPos, 1 ), cViewProj );
	o.uv = v.vTexCoord0;
	o.worldPos = worldPos;
	o.worldNormal = normalize( worldNormal );
	o.screen = o.projPos;
	o.atten.x = GetVertexAttenForLight( worldPos, 0, true );
	o.atten.y = GetVertexAttenForLight( worldPos, 1, true );
	o.atten.z = GetVertexAttenForLight( worldPos, 2, true );
	o.atten.w = GetVertexAttenForLight( worldPos, 3, true );
	return o;
}
