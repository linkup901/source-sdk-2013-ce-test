// Static, single-bone river prop. Source DX9 engine standard constants.
float4x4 viewProj : register(c8);
float4x3 model : register(c58);
struct VSIn { float4 pos:POSITION; float2 uv:TEXCOORD0; };
struct VSOut { float4 pos:POSITION; float2 uv:TEXCOORD0; float3 world:TEXCOORD1; float4 screen:TEXCOORD2; };
VSOut main(VSIn v) {
 VSOut o;
 o.world=mul(v.pos,model);
 o.pos=mul(float4(o.world,1),viewProj);
 o.uv=v.uv; o.screen=o.pos;
 return o;
}
