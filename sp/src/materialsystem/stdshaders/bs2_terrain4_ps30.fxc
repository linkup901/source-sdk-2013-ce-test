sampler2D a:register(s0), b:register(s1), c:register(s2), d:register(s3);
sampler2D mask:register(s4), lightmap:register(s5);
sampler2D na:register(s6), nb:register(s7), nc:register(s8), nd:register(s9);
float4 bounds:register(c0); // lower-left world XY, inverse XY extent
float4 scales:register(c1); // independent tiling multipliers
float4 controls:register(c2); // weight contrast, lightmap scale, debug mask, normal strength
float4 fogParams:register(c3), fogColor:register(c4);
float4 eye:register(c5), mode:register(c6);
float4x4 worldToLight:register(c7);
float4 lightOrigin:register(c11), lightColor:register(c12), attenuation:register(c13);
sampler2D flashlight:register(s10), shadowDepth:register(s11);
float4 main(float2 uv:TEXCOORD0,float4 lm:TEXCOORD1,float2 lm3:TEXCOORD2,float4 world:TEXCOORD3,float3 geometricNormal:TEXCOORD4):COLOR {
 float2 muv=saturate((world.xy-bounds.xy)*bounds.zw);
 float4 w=max(tex2D(mask,muv),0);
 // A zero mask falls back to gravel; unused channels remain exactly zero.
 w=pow(w,max(controls.x,0.01));
 w=dot(w,1)>0.000001 ? w/dot(w,1) : float4(1,0,0,0);
 float3 albedo=tex2D(a,uv*scales.x).rgb*w.x+tex2D(b,uv*scales.y).rgb*w.y+tex2D(c,uv*scales.z).rgb*w.z+tex2D(d,uv*scales.w).rgb*w.w;
 float3 n=(tex2D(na,uv*scales.x).rgb*w.x+tex2D(nb,uv*scales.y).rgb*w.y+tex2D(nc,uv*scales.z).rgb*w.z+tex2D(nd,uv*scales.w).rgb*w.w)*2-1;
 n.xy*=controls.w; n=normalize(n);
 float3 dp=saturate(float3(dot(n,float3(0.81649658,0,0.57735027)),dot(n,float3(-0.40824829,0.70710678,0.57735027)),dot(n,float3(-0.40824829,-0.70710678,0.57735027)))); dp*=dp;
 float3 light=(tex2D(lightmap,lm.xy).rgb*dp.x+tex2D(lightmap,lm.zw).rgb*dp.y+tex2D(lightmap,lm3).rgb*dp.z)/max(dot(dp,1),0.0001);
 float3 color=albedo*light*controls.y;
 if(mode.x>0.5) {
  float3 g=normalize(geometricNormal);
  float3 dpdx=ddx(world.xyz), dpdy=ddy(world.xyz);
  float2 dudx=ddx(uv), dudy=ddy(uv);
  float determinant=dudx.x*dudy.y-dudx.y*dudy.x;
  float3 t=normalize((dpdx*dudy.y-dpdy*dudx.y)*(determinant<0 ? -1 : 1));
  float3 b=normalize((-dpdx*dudy.x+dpdy*dudx.x)*(determinant<0 ? -1 : 1));
  float3 wn=normalize(t*n.x+b*n.y+g*n.z);
  float3 delta=lightOrigin.xyz-world.xyz; float distance=length(delta);
  float4 projected=mul(float4(world.xyz,1),worldToLight);
  float3 q=projected.xyz/max(projected.w,0.00001);
  float inside=projected.w>0 && all(q>=0) && all(q<=1);
  float shadow=mode.y>0.5 ? tex2Dproj(shadowDepth,projected).r : 1;
  float falloff=saturate(dot(attenuation.xyz,float3(1,1/max(distance,0.001),1/max(distance*distance,0.001))));
  falloff*=saturate((lightOrigin.w-distance)/max(lightOrigin.w*0.1,1));
  color=albedo*lightColor.rgb*tex2D(flashlight,q.xy).rgb*shadow*inside*falloff*saturate(dot(wn,delta/max(distance,0.001)));
 }
 if(controls.z>0.5) color=w.rgb+w.w*float3(0.7,0.7,0.7);
 float f=0;
 if(eye.w>1.5) {
  float dz=eye.z-world.z;
  float submerged=abs(dz)<0.0001 ? (world.z<fogParams.y ? 1 : 0) : saturate((fogParams.y-world.z)/dz);
  f=saturate(submerged*world.w*fogParams.w);
 } else if(eye.w>0.5) {
  f=saturate(min(fogParams.z,world.w*fogParams.w-fogParams.x)); f*=f;
 }
 return float4(lerp(color,mode.x>0.5 ? float3(0,0,0) : fogColor.rgb,f),1);
}


